# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the server listens on
PORT=3000

# Comma-separated list of valid API keys clients must send as:
#   Authorization: Bearer <key>
API_KEYS=change-me-to-a-long-random-string

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# development | production
NODE_ENV=development

# trace | debug | info | warn | error
LOG_LEVEL=info

# Which ProfileProvider implementation to use.
# Currently only "mock" is implemented. See src/providers/index.ts.
PROFILE_PROVIDER=mock
